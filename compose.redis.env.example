# Redis Compose configuration. Copy to `compose.redis.env` to change a default.
#
# The project name is deliberately not the PostgreSQL one: Redis runs as its own
# Compose project so its lifecycle stays independent.
COMPOSE_PROJECT_NAME=next-fullstack-starter-redis

REDIS_IMAGE=redis:8.2.2-alpine

REDIS_CONTAINER_NAME=next-fullstack-starter-redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_CPUS=0.50
REDIS_MEM_LIMIT=320m
REDIS_MEM_RESERVATION=128m
REDIS_PIDS_LIMIT=150
REDIS_LOG_MAX_SIZE=10m
REDIS_LOG_MAX_FILE=3

REDIS_TEST_CONTAINER_NAME=next-fullstack-starter-redis-test
REDIS_TEST_PORT=6380
REDIS_TEST_MAXMEMORY=128mb
REDIS_TEST_MAXMEMORY_POLICY=noeviction
REDIS_TEST_CPUS=0.50
REDIS_TEST_MEM_LIMIT=192m
REDIS_TEST_MEM_RESERVATION=64m
REDIS_TEST_PIDS_LIMIT=100
REDIS_TEST_LOG_MAX_SIZE=5m
REDIS_TEST_LOG_MAX_FILE=2
