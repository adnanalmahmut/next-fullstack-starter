COMPOSE_PROJECT_NAME=next-fullstack-starter

POSTGRES_IMAGE=postgres:18.4-alpine
POSTGRES_CONTAINER_NAME=next-fullstack-starter-postgres
POSTGRES_USER=next_fullstack
POSTGRES_DB=next_fullstack_starter
POSTGRES_PORT=5432
POSTGRES_PASSWORD_FILE=./.secrets/postgres_password
POSTGRES_CPUS=1.00
POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=256m
POSTGRES_PIDS_LIMIT=200
POSTGRES_SHM_SIZE=128m
POSTGRES_LOG_MAX_SIZE=10m
POSTGRES_LOG_MAX_FILE=3

POSTGRES_TEST_CONTAINER_NAME=next-fullstack-starter-postgres-test
POSTGRES_TEST_USER=next_fullstack_test
POSTGRES_TEST_DB=next_fullstack_starter_test
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_PASSWORD_FILE=./.secrets/postgres_test_password
POSTGRES_TEST_CPUS=0.50
POSTGRES_TEST_MEM_LIMIT=384m
POSTGRES_TEST_MEM_RESERVATION=128m
POSTGRES_TEST_PIDS_LIMIT=150
POSTGRES_TEST_SHM_SIZE=128m
POSTGRES_TEST_LOG_MAX_SIZE=5m
POSTGRES_TEST_LOG_MAX_FILE=2
