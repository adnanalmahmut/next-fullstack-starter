# Object storage Compose configuration. Copy to `compose.storage.env` before
# starting MinIO.
#
# The project name is deliberately neither the PostgreSQL nor the Redis one:
# storage runs as its own Compose project so its lifecycle stays independent.
COMPOSE_PROJECT_NAME=next-fullstack-starter-storage

# Pinned to a release, never `latest`. An object store that changed version
# between two runs would make an integration failure impossible to attribute.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

MINIO_CONTAINER_NAME=next-fullstack-starter-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Required: Compose refuses to start the development MinIO without them, and
# there is deliberately no default. Generate a password with:
#   openssl rand -base64 24
# Replace both values below; these are placeholders, not credentials.
MINIO_ROOT_USER=replace_with_local_value
MINIO_ROOT_PASSWORD=replace_with_local_secret

MINIO_CPUS=1.00
MINIO_MEM_LIMIT=768m
MINIO_MEM_RESERVATION=256m
MINIO_PIDS_LIMIT=200
MINIO_LOG_MAX_SIZE=10m
MINIO_LOG_MAX_FILE=3

# The test container. It has no persistence, a different port, and credentials
# that authorize nothing beyond the container's own lifetime, so these defaults
# are safe to keep as they are.
MINIO_TEST_CONTAINER_NAME=next-fullstack-starter-minio-test
MINIO_TEST_PORT=9100
MINIO_TEST_ROOT_USER=storagetestuser
MINIO_TEST_ROOT_PASSWORD=storagetestpassword
MINIO_TEST_CPUS=0.75
MINIO_TEST_MEM_LIMIT=512m
MINIO_TEST_MEM_RESERVATION=128m
MINIO_TEST_PIDS_LIMIT=150
MINIO_TEST_LOG_MAX_SIZE=5m
MINIO_TEST_LOG_MAX_FILE=2
