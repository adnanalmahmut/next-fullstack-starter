{
  "name": "next-fullstack-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose --env-file compose.env up -d --wait postgres",
    "db:down": "docker compose --env-file compose.env --profile test down --remove-orphans",
    "db:reset": "docker compose --env-file compose.env --profile test down --volumes --remove-orphans",
    "db:status": "docker compose --env-file compose.env --profile test ps",
    "db:logs": "docker compose --env-file compose.env logs -f postgres",
    "db:test:up": "docker compose --env-file compose.env --profile test up -d --wait postgres-test",
    "db:test:down": "docker compose --env-file compose.env --profile test rm -sf postgres-test",
    "db:test:logs": "docker compose --env-file compose.env --profile test logs -f postgres-test",
    "db:format": "prisma format",
    "db:format:check": "prisma format --check",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "lint": "eslint --max-warnings=0",
    "architecture:check": "depcruise --config .dependency-cruiser.js --output-type err-long -- src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm architecture:check && pnpm typecheck",
    "verify": "pnpm db:format:check && pnpm db:validate && pnpm db:generate && pnpm check && pnpm test:coverage && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@next/env": "16.2.12",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.29.0 <11"
  }
}
