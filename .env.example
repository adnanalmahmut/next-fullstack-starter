APP_ENV=development
DATABASE_URL=postgresql://next_fullstack:replace_with_local_secret@127.0.0.1:5432/next_fullstack_starter?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_local_secret_at_least_32_characters

# Redis is optional. Leave it disabled and the application never contacts it.
# `REDIS_URL` becomes required only when `REDIS_ENABLED` is true, and accepts
# only redis:// or rediss://. There is no default URL.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=next-fullstack-starter
# REDIS_CONNECT_TIMEOUT_MS=5000

# Background jobs are optional, and come in two independent levels.
#
# `JOBS_ENABLED` turns the transactional outbox on. Writing an outbox row is an
# insert inside the caller's own transaction, so it needs no Redis, no queue,
# and no worker — the application keeps recording work while both are down.
#
# `JOBS_REDIS_URL` is needed only to build a queue, a worker, or the dispatcher,
# which means only by the separate `pnpm jobs:worker` process. It accepts only
# redis:// or rediss://, and there is no default and no localhost fallback. It
# may point at the same server as `REDIS_URL` or at a different one; BullMQ
# manages its own key namespace underneath `JOBS_QUEUE_PREFIX`.
JOBS_ENABLED=false
# JOBS_REDIS_URL=redis://127.0.0.1:6379
# JOBS_QUEUE_PREFIX=next-fullstack-starter-jobs
# JOBS_WORKER_CONCURRENCY=5
# JOBS_WORKER_SHUTDOWN_TIMEOUT_MS=30000
# OUTBOX_BATCH_SIZE=25
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_LEASE_MS=30000
# OUTBOX_MAX_PUBLISH_ATTEMPTS=10
# OUTBOX_BACKOFF_BASE_MS=1000
