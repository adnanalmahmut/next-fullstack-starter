APP_ENV=development
DATABASE_URL=postgresql://next_fullstack:replace_with_local_secret@127.0.0.1:5432/next_fullstack_starter?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_local_secret_at_least_32_characters

# Redis is optional. Leave it disabled and the application never contacts it.
# `REDIS_URL` becomes required only when `REDIS_ENABLED` is true, and accepts
# only redis:// or rediss://. There is no default URL.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=next-fullstack-starter
# REDIS_CONNECT_TIMEOUT_MS=5000

# Background jobs are optional, and come in two independent levels.
#
# `JOBS_ENABLED` turns the transactional outbox on. Writing an outbox row is an
# insert inside the caller's own transaction, so it needs no Redis, no queue,
# and no worker — the application keeps recording work while both are down.
#
# `JOBS_REDIS_URL` is needed only to build a queue, a worker, or the dispatcher,
# which means only by the separate `pnpm jobs:worker` process. It accepts only
# redis:// or rediss://, and there is no default and no localhost fallback. It
# may point at the same server as `REDIS_URL` or at a different one; BullMQ
# manages its own key namespace underneath `JOBS_QUEUE_PREFIX`.
JOBS_ENABLED=false
# JOBS_REDIS_URL=redis://127.0.0.1:6379
# JOBS_QUEUE_PREFIX=next-fullstack-starter-jobs
# JOBS_WORKER_CONCURRENCY=5
# JOBS_WORKER_SHUTDOWN_TIMEOUT_MS=30000
# OUTBOX_BATCH_SIZE=25
# OUTBOX_POLL_INTERVAL_MS=1000
# OUTBOX_LEASE_MS=30000
# OUTBOX_MAX_PUBLISH_ATTEMPTS=10
# OUTBOX_BACKOFF_BASE_MS=1000

# Object storage is optional. Leave it disabled and the application never builds
# a client, reads a credential, or opens a socket. It is S3-compatible, so the
# same variables configure AWS S3, Cloudflare R2, and MinIO.
#
# `STORAGE_REGION` and `STORAGE_BUCKET` become required only when
# `STORAGE_ENABLED` is true. `STORAGE_ENDPOINT` is optional — omitting it selects
# AWS S3's own regional endpoint — and required in practice for R2 and MinIO.
# There is no default endpoint and no localhost fallback.
#
# The bucket must be private. The application never issues a public URL and
# never sets an ACL; every download is a signature measured in minutes.
#
# The credential pair is set together or left out together. Leaving both out
# selects the AWS default credential chain, which is how a deployment on AWS
# authenticates with an instance role instead of a stored key.
STORAGE_ENABLED=false
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=next-fullstack-starter
# STORAGE_ACCESS_KEY_ID=replace_with_local_value
# STORAGE_SECRET_ACCESS_KEY=replace_with_local_secret
# STORAGE_SESSION_TOKEN=
# MinIO addresses a bucket in the path rather than the hostname.
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_KEY_PREFIX=next-fullstack-starter
# STORAGE_CONNECT_TIMEOUT_MS=5000
# STORAGE_REQUEST_TIMEOUT_MS=15000
# An upload form must not outlive the intent it belongs to, and the finalization
# lease must be shorter than the intent.
# STORAGE_UPLOAD_URL_TTL_SECONDS=900
# STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# STORAGE_UPLOAD_INTENT_TTL_SECONDS=900
# STORAGE_FINALIZE_LEASE_MS=30000
# 25 MiB. Capped at 5 GiB, the largest a single request can carry.
# STORAGE_MAX_UPLOAD_BYTES=26214400

# Production telemetry is optional. Leave it disabled and the application never
# loads an OpenTelemetry SDK, never builds an exporter, never starts an export
# timer, never resolves a hostname, and never opens a socket. Traces and metrics
# both leave over one transport — OTLP/HTTP — to one collector.
#
# `TELEMETRY_OTLP_ENDPOINT` becomes required only when `TELEMETRY_ENABLED` is
# true. It accepts only http:// or https://, and there is no default and no
# localhost fallback: an enabled telemetry with nowhere to export to is a
# configuration mistake rather than something to guess at. It must not embed a
# username or a password — authentication belongs in the headers below — and it is
# never logged. The signal paths (`/v1/traces`, `/v1/metrics`) are appended by the
# application, so give the collector's base URL.
TELEMETRY_ENABLED=false
# TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318
# A bounded comma-separated list of name=value pairs, and a credential: it is
# never logged, never serialized, and never echoed in a validation error.
# TELEMETRY_OTLP_HEADERS=authorization=Bearer-replace_with_local_secret
# Parent-based trace-id ratio sampling, from 0 to 1. A sampled trace is sampled
# end to end — request, outbox row, and job together. Defaults to 1 outside
# production and 0.1 in production.
# TELEMETRY_TRACE_SAMPLE_RATIO=0.1
# The metric collection interval, and the deadline for one export. The timeout
# must not exceed the interval, or a collection would still be running when the
# next one began.
# TELEMETRY_METRIC_EXPORT_INTERVAL_MS=60000
# TELEMETRY_EXPORT_TIMEOUT_MS=10000
# The release identifier, when a deployment has one. It becomes `service.version`
# on every span and metric and the release on every captured error. It is never
# derived by running `git` at runtime, and its absence is not a failure.
# APP_RELEASE=

# Server-side error monitoring is optional and independent of `TELEMETRY_ENABLED`:
# traces and metrics go to a collector, unexpected failures go to a vendor, and
# neither switch may disable the other. Leave it disabled and the Sentry SDK is
# never loaded, no DSN is held, and nothing is sent.
#
# Only unexpected and internal failures are reported. A validation error, an
# unauthenticated call, a forbidden call, a missing resource, a conflict, and a
# refused rate are ordinary traffic and are never sent. Every event is rebuilt from
# an allowlist first: no request, no headers, no cookies, no body, no user, no
# breadcrumbs, no local variables, and no exception message — a stable error code
# takes its place.
#
# `SENTRY_DSN` becomes required only when `ERROR_MONITORING_ENABLED` is true. It is
# a credential: it is never logged and never returned in a validation error.
ERROR_MONITORING_ENABLED=false
# SENTRY_DSN=https://replace_with_local_public_key@o0.ingest.sentry.io/0
